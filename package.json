  "homepage": "https://github.com/xtxo/dsh-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xtxo/dsh-ui.git"
  },
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:debug": "tauri build --debug",
    "build:mac": "tauri build --target universal-apple-darwin",
